<Window x:Class="ICloudFolderSetup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="iCloud folder setup">
 <Grid x:Name="Root">
  <NavigationView x:Name="Navigation" IsSettingsVisible="False" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" SelectionChanged="NavigationChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Folder locations" Tag="Locations" Icon="Folder" IsSelected="True" />
    <NavigationViewItem Content="Copy files" Tag="Copy" Icon="Copy" />
    <NavigationViewItem Content="Check setup" Tag="Check" Icon="Find" />
    <NavigationViewItem Content="Cloud verification" Tag="Cloud"><NavigationViewItem.Icon><FontIcon Glyph="&#xE753;" /></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="Help" Tag="Help" Icon="Help" />
     <NavigationViewItem Content="Recovery files" Tag="Recovery" Icon="OpenFile" />
     <NavigationViewItem Content="Install for me" Tag="Install" Icon="Download" AutomationProperties.AutomationId="InstallNavigation" />
   </NavigationView.FooterMenuItems>
   <Grid Padding="24" RowSpacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer x:Name="MainScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
     <StackPanel Spacing="20" Padding="0,0,8,8">
    <StackPanel Spacing="8">
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Padding="8" CornerRadius="8" Background="{ThemeResource CloudIdentityBackgroundBrush}" BorderBrush="{ThemeResource IdentityBorderBrush}" BorderThickness="1" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon x:Name="CloudIdentityIcon" Glyph="&#xE753;" FontSize="18" Foreground="{ThemeResource CloudIdentityBrush}" />
        <Grid Width="16" Height="16" ColumnSpacing="2" RowSpacing="2">
         <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
         <Rectangle x:Name="WindowsIdentityTile" Fill="{ThemeResource WindowsIdentityBrush}" /><Rectangle Grid.Column="1" Fill="{ThemeResource WindowsIdentityBrush}" />
         <Rectangle Grid.Row="1" Fill="{ThemeResource WindowsIdentityBrush}" /><Rectangle Grid.Row="1" Grid.Column="1" Fill="{ThemeResource WindowsIdentityBrush}" />
        </Grid>
       </StackPanel>
      </Border>
      <TextBlock Grid.Column="1" Text="Windows folders &#x00B7; iCloud Drive" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
     </Grid>
     <TextBlock x:Name="PageTitle" Text="Folder locations" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
     <TextBlock x:Name="PageDescription" Text="Choose an action, preview the paths, then confirm the change. Existing files stay in place." TextWrapping="Wrap" />
    </StackPanel>
      <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
       <StackPanel x:Name="Options" Spacing="16">
        <ComboBox x:Name="ActionChoice" Header="Action" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" AutomationProperties.AutomationId="ActionChoice" />
        <Grid x:Name="CloudRootRow" ColumnSpacing="12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <TextBox x:Name="CloudRoot" Header="iCloud Drive folder" TextChanged="OptionsChanged" AutomationProperties.AutomationId="CloudRoot" AutomationProperties.HelpText="Choose the existing iCloud Drive folder. Preview checks its Windows registration; registration does not prove synchronization." />
         <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseRoot" AccessKey="B" AutomationProperties.AutomationId="BrowseRoot" AutomationProperties.Name="Browse for iCloud Drive folder" />
        </Grid>
        <Grid x:Name="BackupRow" ColumnSpacing="12" Visibility="Collapsed">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <TextBox x:Name="BackupFile" Header="Recovery backup (before.json)" TextChanged="OptionsChanged" AutomationProperties.AutomationId="BackupFile" AutomationProperties.HelpText="Choose a trusted before.json backup for this Windows account. Preview validates it before restoring any settings." />
         <Button Grid.Column="1" Content="Choose…" VerticalAlignment="Bottom" Click="BrowseBackup" AutomationProperties.AutomationId="BrowseBackup" AutomationProperties.Name="Choose recovery backup" />
        </Grid>
        <CheckBox x:Name="Music" Content="Include Music" Checked="OptionsChanged" Unchecked="OptionsChanged" AutomationProperties.HelpText="Include Music in this action. Reset to Windows defaults always includes Music." />
        <Expander x:Name="Advanced" Header="Advanced options" HorizontalAlignment="Stretch">
         <StackPanel Spacing="12">
          <CheckBox x:Name="ManualRoot" Checked="OptionsChanged" Unchecked="OptionsChanged" AutomationProperties.HelpText="Use only when Windows has no iCloud registration. A known folder mismatch cannot be overridden."><TextBlock Text="Use a manually verified iCloud folder" TextWrapping="Wrap" /></CheckBox>
          <TextBlock Text="Only when Windows has no iCloud registration. A known folder mismatch cannot be overridden." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
          <CheckBox x:Name="KeepFiles" Checked="OptionsChanged" Unchecked="OptionsChanged" AutomationProperties.HelpText="Existing files stay where they are. Use a separate Copy files action first to merge existing content."><TextBlock Text="Change locations without copying existing files" TextWrapping="Wrap" /></CheckBox>
          <TextBlock Text="To merge existing content, run a separate Copy files action first. Originals are always retained." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
         </StackPanel>
        </Expander>
        <CheckBox x:Name="JsonOutput" Content="Show diagnostics as JSON" Visibility="Collapsed" Checked="OptionsChanged" Unchecked="OptionsChanged" />
       </StackPanel>
      </Border>
      <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Severity="Informational" Title="Ready to preview" Message="Previewing does not change folder settings." AutomationProperties.AutomationId="OperationStatus" AutomationProperties.LiveSetting="Polite" />
      <ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" AutomationProperties.Name="Operation progress" />
      <TextBlock x:Name="CurrentFile" TextWrapping="Wrap" Visibility="Collapsed" IsTextSelectionEnabled="True" />
      <StackPanel Spacing="8">
       <TextBlock Text="Plan and results" Style="{StaticResource SubtitleTextBlockStyle}" />
       <TextBox x:Name="Results" Text="Your reviewed plan will appear here." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" AutomationProperties.Name="Plan and results" AutomationProperties.AutomationId="Results" />
       <StackPanel Orientation="Horizontal" Spacing="12">
        <CheckBox x:Name="Technical" Content="Technical details" Checked="TechnicalChanged" Unchecked="TechnicalChanged" />
        <Button x:Name="Save" Content="Save result…" Click="SaveResult" />
       </StackPanel>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" ColumnSpacing="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button x:Name="Preview" Content="Preview" Click="PreviewClick" AccessKey="P" AutomationProperties.AutomationId="Preview" />
      <Button x:Name="DryRun" Grid.Column="1" Content="Dry run" Click="DryRunClick" AccessKey="D" AutomationProperties.AutomationId="DryRun" />
      <Button x:Name="Apply" Grid.Column="2" Content="Change locations…" Click="ApplyClick" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="Apply">
       <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate></Button.ContentTemplate>
      </Button>
     <Button x:Name="Stop" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="Stop after current file" Click="StopClick" Visibility="Collapsed" AutomationProperties.AutomationId="Stop" />
    </Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
